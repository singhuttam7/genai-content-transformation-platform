APP_NAME=GenAI Content Transformation Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genai_content_platform

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DATABASE_URL=

SECRET_KEY=replace-with-a-secure-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
MAX_UPLOAD_SIZE_MB=100

# URL ingestion / outbound HTTP
URL_FETCH_TIMEOUT_SECONDS=15
URL_MAX_RESPONSE_SIZE_MB=10
URL_MAX_REDIRECTS=5